```gitignore
# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# .NET / ASP.NET Core
# ==========================================
**/bin/
**/obj/
**/out/

# NuGet packages
*.nupkg
*.snupkg

# User-specific files
*.user
*.suo

# Visual Studio
.vs/
.vscode/
*.userosscache
*.sln.docstates

# ==========================================
# Node.js / React / Vite
# ==========================================
**/node_modules/
**/dist/
**/coverage/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDEs
# ==========================================
.idea/

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
